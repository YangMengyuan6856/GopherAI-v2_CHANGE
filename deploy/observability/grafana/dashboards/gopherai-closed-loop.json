    },
    {
      "datasource": {"type": "prometheus", "uid": "gopherai-prometheus"},
      "description": "5 分钟请求速率；按固定 intent/strategy 枚举聚合，不包含用户、会话或请求标识。",
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"editorMode": "code", "expr": "sum by (intent, strategy) (gopherai:request_rate5m)", "legendFormat": "{{intent}} · {{strategy}}", "range": true, "refId": "A"}],
      "title": "请求吞吐（5m rate）",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gopherai-prometheus"},
      "description": "成功请求 / 全部请求的 5 分钟速率比；无流量时不作为健康证明。",
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 90}, {"color": "green", "value": 98}]}, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
