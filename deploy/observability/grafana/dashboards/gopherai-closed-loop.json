      "title": "端到端延迟 P95（5m）",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "gopherai-prometheus"},
      "description": "按策略统计最近 5 分钟请求样本；低样本时异常检测保持 insufficient_data。",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
